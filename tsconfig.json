{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2015",
    "rootDir": ".",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist", "jest.config.ts", "coverage", "docs"]
}
